{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code knowledge index manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "layer", "repository_id", "source_commit", "branch", "generator", "compile_context_hash", "inputs_hash", "created_at", "trust", "validation"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "layer": {"enum": ["base", "branch_overlay", "worktree_overlay"]},
    "repository_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "minLength": 1},
    "base_index_commit": {"type": ["string", "null"]},
    "worktree_fingerprint": {"type": ["string", "null"]},
    "branch": {"type": "string", "minLength": 1},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "parser_version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "parser_version": {"type": "string"}
      }
    },
    "compile_context_hash": {"type": "string", "minLength": 1},
    "embedding_configuration_hash": {"type": ["string", "null"]},
    "inputs_hash": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "trusted"],
      "properties": {
        "publisher": {"type": "string"},
        "trusted": {"type": "boolean"}
      }
    },
    "statistics": {"type": "object"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failures"],
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "failures": {"type": "array", "items": {"type": "string"}}
      }
    },
    "artefact_checksum": {"type": "string"}
  }
}
