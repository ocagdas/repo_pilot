{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering completion report",
  "type": "object",
  "required": [
    "schema_version",
    "source_revision",
    "snapshot",
    "tasks",
    "acceptance_criteria",
    "checks",
    "review",
    "changed_files",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidence",
          "remaining_work"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "completed",
              "incomplete",
              "untouched"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "remaining_work": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidence",
          "remaining_work"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "completed",
              "incomplete",
              "untouched"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "remaining_work": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "result",
          "context",
          "evidence"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unavailable"
            ]
          },
          "context": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "kind",
        "result",
        "evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "independent",
            "self",
            "none"
          ]
        },
        "result": {
          "enum": [
            "pass",
            "changes_required",
            "pending"
          ]
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
